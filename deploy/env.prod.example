# ARACHNE-X-ULTRA-V3 NIGHTCORE — production env template
# Copy to pod secrets / orchestrator + worker env. Do not commit real keys.

NULLXES_PRODUCTION=1

# --- Orchestrator (src/server) ---
NULLXES_REALTIME_SERVICE_KEY=change-me-realtime
NULLXES_AVATAR_INFERENCE_URL=https://worker-pod:8000
NULLXES_WS_AVATAR_STREAM_MODE=inference
NULLXES_MEDIA_BACKEND=pulse
# NULLXES_SPEECH_REMOTE_URL deferred to V3.1 — use separate speech pod topology when needed

# --- Inference worker ---
NULLXES_INFERENCE_SERVICE_KEY=change-me-inference
NULLXES_CHECKPOINT_DIR=/workspace/weights/arachne-avatar-runtime

# --- Engine (80GB tiers) ---
ARACHNE_RUNTIME_PROFILE=operational
ARACHNE_TORCH_COMPILE=0
ARACHNE_CHUNK_KV=0
ARACHNE_PHONEME_ENABLED=0
ARACHNE_INFER_ENABLE_BSA=1
ARACHNE_AUDIO_ENCODER=wav2vec

# --- Banned in production (prod_guard fails boot if set) ---
# ARACHNE_LEGACY_STREAMING=1
# NULLXES_ALLOW_DEV_STUB=1
# NULLXES_CHAT_ASSISTANT_FIXED_REPLY=...
# ALLOW_INFERENCE_DEV_MOCK=1
