{
  "schema_version": 1,
  "deployment": {
    "target": "runpod_single_h200",
    "clone_hint": "https://github.com/MagistrTheOne/ARACHNE-X-NULLXES-.git",
    "weights": "Prefer local HF cache or HF_HOME; LongCat-Video + LongCat-Video-Avatar on the same GPU need scheduling (see job queue on longcat-worker)."
  },
  "vad": {
    "backend": "silero_onnx",
    "model_id": "snakers4/silero-vad",
    "sample_rate_hz": 16000,
    "note": "Do not use FluidInference/silero-vad-coreml on Linux — CoreML is Apple-only."
  },
  "asr": {
    "backend": "faster_whisper",
    "model_id": "Systran/faster-whisper-large-v3",
    "device": "cuda",
    "compute_type": "float16",
    "language": null,
    "beam_size": 5
  },
  "llm": {
    "backend": "transformers_or_vllm",
    "model_id": "Qwen/Qwen2.5-7B-Instruct",
    "device_map": "auto",
    "max_new_tokens": 512,
    "temperature": 0.7,
    "demo_phrase": "Здравствуйте, я готов продолжить интервью."
  },
  "tts": {
    "backend": "qwen3_tts",
    "model_id": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
    "device_map": "cuda:0",
    "sample_rate_hz": 24000,
    "note": "arachne_x/tts/factory.py defaults to CustomVoice HF id; override model_id to match this Base checkpoint if your synthesizer supports it."
  },
  "avatar": {
    "backend": "longcat_worker_http",
    "inference_url_env": "NULLXES_AVATAR_INFERENCE_URL",
    "video_model_id": "meituan-longcat/LongCat-Video",
    "avatar_model_id": "meituan-longcat/LongCat-Video-Avatar",
    "use_async_jobs_env": "NULLXES_AVATAR_INFERENCE_ASYNC",
    "worker_jobs_path_env": "NULLXES_AVATAR_INFERENCE_JOBS_PATH",
    "fail_once": false
  },
  "webrtc": {
    "role": "target_transport",
    "signaling": "dashboard_ws_plus_future_rtc",
    "audio_in": "opus_decode_to_pcm",
    "audio_out": "tts_pcm_or_opus",
    "video_out": "encoded_from_avatar_frames"
  }
}
